# Repeat character N times using a function and echo
repeat(){ for i in {1..80}; do echo -n "$1"; done }
repeat '-'
echo
repeat '='
echo
repeat '═'
echo
repeat '─'  
echo

repeat '~'; echo -e '\nCol 1\t\tCol 2\t\tCol 3\t\t\t\tCol 4'; repeat '~'; echo



# Reapet a character N times using printf
printf -- '-%.0s' {1..80} #-- needed to print N times -

echo ""
echo "  ╔═══════════════════════════════════╗"
echo "  ║      Repeat characters N times    ║"
echo "  ╚═══════════════════════════════════╝"
echo ""

printf -- '=%.0s' {1..80}   # Prints = N times, N=80
printf '\n'
printf -- '═%.0s' {1..80}
printf '\n'
printf -- '─%.0s' {1..80}
printf '\n'
