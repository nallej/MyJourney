#!/usr/bin/env bash
#
# InitColor
#
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
END='\033[0m'

info()  { echo -e "${GREEN}[+]${END} $1"; }
warn()  { echo -e "${YELLOW}[!]${END} $1"; }
error() { echo -e "${RED}[x]${END} $1"; exit 1; }

echo ""
echo "  ╔═══════════════════════════════════╗"
echo "  ║    TemplateBuilder — Installer    ║"
echo "  ╚═══════════════════════════════════╝"
echo ""
